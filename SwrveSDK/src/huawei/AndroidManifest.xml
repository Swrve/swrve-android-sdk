<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.swrve.sdk"
    android:versionCode="2"
    android:versionName="2.8">

    <application>
        <service
            android:name="com.swrve.sdk.SwrveFirebaseMessagingService"
            android:exported="false">
            <intent-filter android:priority="-1"> <!-- Priority is a best-effort hint only; app-defined FCM service should always take precedence -->
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name="com.swrve.sdk.SwrveHmsMessageService"
            android:exported="false">
            <intent-filter android:priority="-1"> <!-- Priority is a best-effort hint only; app-defined HMS service should always take precedence -->
                <action android:name="com.huawei.push.action.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="push_kit_auto_init_enabled"
            android:value="true" />
    </application>
</manifest>
