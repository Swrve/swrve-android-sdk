<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material3-based theme using Swrve blue palette -->
    <style name="Theme.SwrveEmbeddedSample.M3" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (affects buttons, FABs, active controls) -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_700</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary/accent colors (used for highlights, chips, etc.) -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Surface and background (keep neutral for a clean look) -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <!-- Transparent status bar for edge-to-edge; we'll control icon appearance in code -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>